# PostgreSQL + pgvector
DATABASE_URL=postgresql://rag_app:replace-with-your-database-password@127.0.0.1:5432/rag_demo

# llama.cpp Embedding service
EMBEDDING_BASE_URL=http://127.0.0.1:8081
EMBEDDING_API_KEY=replace-with-your-local-api-key
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=32

# llama.cpp Reranker service
RERANKER_BASE_URL=http://127.0.0.1:8082
RERANKER_API_KEY=replace-with-your-local-api-key
RERANKER_MODEL=bge-reranker-v2-m3
RERANKER_TIMEOUT_SECONDS=60

# Chunking
CHUNK_TARGET_CHARS=1400
CHUNK_MAX_CHARS=2200
CHUNK_OVERLAP_CHARS=200

# Retrieval
DENSE_TOP_K=30
BM25_TOP_K=30
RRF_RANK_CONSTANT=60
RERANK_TOP_K=20
FINAL_TOP_K=5
HNSW_EF_SEARCH=100
